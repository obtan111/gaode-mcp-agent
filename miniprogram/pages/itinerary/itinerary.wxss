.it-page {
  background: #F4F6FB;
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 概览头部 */
.it-head {
  background: linear-gradient(135deg, #3D6BFF, #6A9BFF);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}
.it-head-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.it-head-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.meta-tag {
  background: rgba(255, 255, 255, 0.22);
  border-radius: 10rpx;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
}
.it-head-weather {
  font-size: 24rpx;
  opacity: 0.92;
  line-height: 1.6;
}
.it-head-weather .label {
  background: rgba(255, 255, 255, 0.22);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 10rpx;
  font-size: 22rpx;
}

/* 每日卡片 */
.day-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.05);
}
.day-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.day-badge {
  background: #3D6BFF;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
}
.day-date {
  color: #5A6068;
  font-size: 26rpx;
  margin-left: 16rpx;
}
.day-weather {
  margin-left: auto;
  color: #8A9099;
  font-size: 24rpx;
}

.slot {
  border-left: 6rpx solid #D6E2FF;
  padding: 4rpx 0 4rpx 24rpx;
  margin-bottom: 20rpx;
}
.slot-label {
  color: #3D6BFF;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.slot-activity {
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2329;
  margin-bottom: 8rpx;
}
.slot-desc {
  font-size: 24rpx;
  color: #5A6068;
  line-height: 1.7;
  margin-bottom: 8rpx;
  white-space: pre-wrap;
  word-break: break-word;
}
.slot-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}
.row-item {
  font-size: 24rpx;
  color: #5A6068;
  margin-right: 24rpx;
}
.row-item.cost {
  color: #E67E22;
}
.slot-empty {
  color: #A0A6AD;
  font-size: 26rpx;
  padding: 8rpx 0 16rpx;
}

/* 小贴士 */
.tips-card {
  background: #FFF8EC;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #B8860B;
  margin-bottom: 16rpx;
}
.tip-item {
  font-size: 26rpx;
  color: #7A6222;
  line-height: 1.8;
}

/* 地图可视化卡片 */
.map-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.06);
}
.day-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.tab {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #F4F6FB;
  color: #5A6068;
  font-size: 24rpx;
}
.tab.active {
  background: #3D6BFF;
  color: #FFFFFF;
}
.trip-map {
  width: 100%;
  height: 460rpx;
  border-radius: 16rpx;
}
.map-hint {
  color: #A0A6AD;
  font-size: 22rpx;
  margin-top: 12rpx;
}
