/* 全局样式 */
page {
  background: #F4F6FB;
  font-size: 28rpx;
  color: #1F2329;
  -webkit-font-smoothing: antialiased;
}

.container {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 通用按钮 */
.btn-primary {
  background: #3D6BFF;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  line-height: 1.4;
}
.btn-primary[disabled] {
  background: #A9C0FF;
  color: #fff;
}

/* 空态 */
.empty-state {
  padding: 160rpx 60rpx;
  text-align: center;
  color: #8A9099;
  font-size: 28rpx;
}
.empty-state .empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}
