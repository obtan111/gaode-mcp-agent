# AI 旅行助手 - Caddy 反向代理配置（HTTPS + WSS 自动证书）
#
# 使用：把 api.example.com 换成你的备案域名，由 deploy.sh 自动替换并复制到 /etc/caddy/Caddyfile
# 说明：WebSocket 升级（/api/chat/ws）由 Caddy 自动透传，后端零改动；
#       证书由 Caddy 自动向 Let's Encrypt 申请并续期。

api.example.com {
	encode zstd gzip

	# 后端 FastAPI（只监听 127.0.0.1:8100，不经公网直接暴露）
	reverse_proxy 127.0.0.1:8100
}
