# 环境变量配置模板
# 复制此文件为 .env 并填入你的配置

# ======== 数据库配置 (Supabase) ========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ======== 大模型 API Key ========
# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 智谱 AI API
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-4-flash
# 智谱视觉模型（图片识别）
ZHIPU_VL_MODEL=glm-4v-flash

# ======== 高德地图 API ========
AMAP_API_KEY=your-amap-api-key

# ======== RAG 检索参数 ========
# 每个检索器返回的结果数量
RETRIEVE_TOP_K=10
# RRF 融合参数 k 值
RRF_K=60
# Cross-Encoder 分数阈值
CROSS_ENCODER_THRESHOLD=0.5
# 返回文本最大长度
MAX_TEXT_LENGTH=2000

# ======== MCP 工具配置 ========
# 最大工具调用次数
MAX_TOOL_CALLS=5
# MCP 缓存大小
MCP_CACHE_SIZE=100
# MCP 缓存 TTL（秒）
MCP_CACHE_TTL=3600

# ======== 日志配置 ========
LOG_LEVEL=INFO

# ======== 其他 ========
# HuggingFace 镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS=1

# 流式聊天模式：updates=节点状态+伪流(默认,稳定) / multi=真实token流(需 langchain 兼容版本)
CHAT_STREAM_MODE=updates
